---
interface Props {
  locale?: "ru" | "en";
}

const { locale = "ru" } = Astro.props;

const dictionary = {
  ru: {
    message: "Мы используем куки для аналитики",
    accept: "ОК",
    label: "Уведомление об использовании cookie",
  },
  en: {
    message: "We use cookies for analytics",
    accept: "OK",
    label: "Cookie usage notice",
  },
} as const;

const content = dictionary[locale];
const popoverId = "cookie-notice";
---

<div popover="manual" id={popoverId} class="_cookie" aria-label={content.label}>
  <p class="_cookie__text">{content.message}</p>

  <button type="button" class="_cookie__btn" data-cookie-accept>
    {content.accept}
  </button>
</div>

<style>
  ._cookie {
    position: fixed;
    height: auto;
    inset: auto 24px 24px auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: center;
    width: min(420px, calc(100vw - 48px));
    margin: 0;
    padding: 12px 20px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    background: rgba(38, 40, 53, 0.96);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.35);
    color: var(--white-color);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--delay) ease,
      transform var(--delay) ease,
      overlay var(--delay) ease allow-discrete,
      display var(--delay) ease allow-discrete;
  }

  ._cookie:popover-open {
    opacity: 1;
    transform: translateY(0);

    @starting-style {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  ._cookie__text {
    margin: 0;
    font-family: var(--font-secondary), sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  ._cookie__btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 72px;
    height: 44px;
    padding: 0 20px;
    border: 1px solid var(--primary-color);
    border-radius: 10px;
    background: var(--primary-color);
    color: var(--grey-50);
    cursor: pointer;
    font-family: var(--font-primary), sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    transition:
      background-color var(--delay) ease-in-out,
      color var(--delay) ease-in-out,
      border-color var(--delay) ease-in-out;
  }

  ._cookie__btn:hover {
    border-color: var(--white-color);
    background: var(--white-color);
  }

  ._cookie__btn:active {
    transform: translateY(1px);
  }

  @media (width < 1081px) {
    ._cookie {
      inset: auto 0 0 0;
      grid-template-columns: 1fr;
      width: 100%;
      border-right: none;
      border-bottom: none;
      border-left: none;
      border-radius: 20px 20px 0 0;
      padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    }

    ._cookie__btn {
      width: 100%;
    }
  }
</style>

<script>
  const storageKey = "tetacom_cookie_accepted";
  const cookieNotice = document.getElementById("cookie-notice");

  if (cookieNotice instanceof HTMLElement && "showPopover" in cookieNotice) {
    const acceptButton = cookieNotice.querySelector("[data-cookie-accept]");

    const hasConsent = () => {
      try {
        return localStorage.getItem(storageKey) === "true";
      } catch {
        return false;
      }
    };

    const saveConsent = () => {
      try {
        localStorage.setItem(storageKey, "true");
      } catch {
        // Ignore storage access issues and still close the notice for this session.
      }
    };

    if (!hasConsent()) {
      cookieNotice.showPopover();
    }

    if (acceptButton instanceof HTMLButtonElement) {
      acceptButton.addEventListener("click", () => {
        saveConsent();
        cookieNotice.hidePopover();
      });
    }
  }
</script>
