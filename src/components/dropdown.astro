---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="_dropdown">
  <slot name="trigger" />

  <div popover id={id} class="_dropdown__body"><slot /></div>
</div>

<style>
  ._dropdown {
    position: relative;
  }

  ._dropdown__body {
    position-area: bottom span-left;
    border: none;
    opacity: 0;
    transform: translateY(0);
    overflow: hidden;
    padding: 4px 0;
    border-radius: 4px;
    background: var(--bg-color);
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.4);
    transition:
      opacity var(--delay) ease,
      transform var(--delay) ease,
      overlay var(--delay) ease allow-discrete,
      display var(--delay) ease allow-discrete;

    &:popover-open {
      opacity: 1;
      transform: translateY(10px);

      @starting-style {
        opacity: 0;
        transform: translateY(0);
      }
    }
  }
</style>
