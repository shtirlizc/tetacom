---
import Container from "../components/container.astro";
import Title from "../components/title.astro";
import { Image } from "astro:assets";
import reviewOpz1Image from "../assets/reviews/review-opz-1.jpg";
import reviewOpz2Image from "../assets/reviews/review-opz-2.jpg";

interface Props {
  locale: "ru" | "en";
}

const { locale } = Astro.props;
const reviewImages = {
  "review-opz-1": reviewOpz1Image,
  "review-opz-2": reviewOpz2Image,
} as const;

const dictionary = {
  ru: {
    title: "Отзывы",
    items: [
      {
        image: "review-opz-1",
        alt: "Отзыв клиента о продукте ОПЗ",
      },
      {
        image: "review-opz-2",
        alt: "Отзыв клиента о продукте ОПЗ",
      },
    ],
  },
  en: {
    title: "Reviews",
    items: [
      {
        image: "review-opz-1",
        alt: "Customer review of the HMO product",
      },
      {
        image: "review-opz-2",
        alt: "Customer review of the HMO product",
      },
    ],
  },
} as const;

const content = dictionary[locale];
---

<section class="_reviews" id="reviews">
  <Container>
    <Title>{content.title}</Title>
    <div class="_reviews__body" id="reviews-gallery">
      {content.items.map((item, index) => {
        const image = reviewImages[item.image];

        return (
          <div class="_reviews__item">
            <a
              data-fslightbox="gallery"
              href={image.src}
              id={`reviews-gallery-item-${index + 1}`}
            >
              <Image src={image} alt={item.alt} widths={[image.width]} />
            </a>
          </div>
        );
      })}
    </div>
  </Container>
</section>

<script>
  import "../vendors/fslightbox.js";

  window.refreshFsLightbox?.();
</script>

<style>
  ._reviews {
    padding: 80px 0;
  }

  ._reviews__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 60px;
  }

  ._reviews__item {
    overflow: hidden;
    padding: 20px;
    border: 1px solid var(--grey-50);
    border-radius: 24px;
  }

  ._reviews__item a {
    display: block;
    font-size: 0;
  }

  ._reviews__item img {
    width: 100%;
    height: auto;
  }

  /* touch */
  @media (width < 1081px) {
    ._reviews__body {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 40px;
    }
  }

  /* desktop */
  @media (width >= 1081px) {
    ._reviews {
      padding: 40px 0;
    }
  }
</style>
